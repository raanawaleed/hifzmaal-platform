APP_NAME=HifzMaal
APP_ENV=local
APP_KEY=
# NEVER set APP_DEBUG=true in production — it leaks stack traces to users.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hifzmaal
DB_USERNAME=root
DB_PASSWORD=

# Production: use database (or redis) for all three, never file/sync.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production: set SESSION_SECURE_COOKIE=true (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production: point at a real provider (Postmark/SES/Mailgun/SMTP).
# Password reset and reminder emails will not work without this.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@hifzmaal.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed if FILESYSTEM_DISK=s3 (receipt uploads).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── HifzMaal ──────────────────────────────────────────────
DEFAULT_CURRENCY=PKR
DEFAULT_LOCALE=en
# Load-bearing, not cosmetic: auth is Sanctum SPA cookie sessions, not
# Bearer tokens. A request only gets session-cookie auth if its
# Origin/Referer matches a domain listed here EXACTLY, port included
# (see EnsureFrontendRequestsAreStateful — "localhost" does NOT match
# "localhost:8000", that's a distinct entry) — add your real production
# domain (no scheme, e.g. app.example.com) or every login will silently
# fail with "Session store not set on request".
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# This user is granted the superadmin role on `php artisan db:seed`.
# You can also promote any user later: php artisan hifzmaal:superadmin you@example.com
SUPERADMIN_EMAIL=

# URL of the built Vue SPA, used to build Stripe redirect/portal links.
# Same as APP_URL unless the frontend is deployed separately.
APP_FRONTEND_URL="${APP_URL}"

# ── Billing (Stripe, always USD — see config/billing.php) ───
CASHIER_CURRENCY=usd
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Price IDs from a "HifzMaal Pro" product in the Stripe Dashboard.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Display-only figures for the public pricing page — must match what the
# Stripe prices above actually charge, this does not set the real amount.
BILLING_PRO_MONTHLY_DISPLAY_PRICE=9
BILLING_PRO_YEARLY_DISPLAY_PRICE=90
BILLING_TRIAL_DAYS=14
BILLING_FREE_MAX_FAMILIES=1
BILLING_FREE_MAX_MEMBERS=4

# Live gold/silver spot prices for Zakat nisab (goldapi.io). Leave blank to
# keep managing rates by hand in the superadmin panel — everything still
# works without this, it just isn't kept fresh automatically.
GOLDAPI_KEY=

# ── Error tracking (Sentry, optional) ────────────────────
# Leave blank to disable entirely — nothing else in config/sentry.php does
# anything without a DSN. Get one free at sentry.io.
SENTRY_LARAVEL_DSN=

# ── Backups (spatie/laravel-backup) ──────────────────────
# Daily DB + storage/app + .env backup, scheduled in routes/console.php.
# Needs `mysqldump` on the PATH (ships with the mysql-client package).
# BACKUP_DISK=local works out of the box but doesn't survive losing the
# server — set to 's3' once AWS_* credentials below are filled in.
BACKUP_DISK=local
# Encrypts the backup zip (recommended: it can contain .env, i.e. secrets).
BACKUP_ARCHIVE_PASSWORD=
# Who gets emailed on backup failure / unhealthy backup. Defaults to
# SUPERADMIN_EMAIL above if left blank.
BACKUP_NOTIFICATION_EMAIL=

# ── Production checklist ─────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# SANCTUM_STATEFUL_DOMAINS=your-domain.com   (no scheme, no port for 80/443)
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=redis          (or database)
# QUEUE_CONNECTION=redis     (or database) + run a queue worker (see INSTALLATION.md)
# Cron entry required:  * * * * * php /path/to/artisan schedule:run >> /dev/null 2>&1
# Stripe: set real STRIPE_KEY/STRIPE_SECRET/STRIPE_WEBHOOK_SECRET and price
# IDs, and register the webhook at https://your-domain.com/api/stripe/webhook
# (see INSTALLATION.md § 8a).
